<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <arg name="config_path" default="$(find-pkg-share vins)/config/realsense_d435i/realsense_stereo_imu_config.yaml"/>
    <arg name="vins_config" default="$(var config_path)"/>
    
    <!-- VINS estimator node -->
    <node name="vins_estimator" pkg="vins" exec="vins_node" args="$(var vins_config)" output="screen"/>
    
    <!-- Optional: Loop fusion node -->
    <!-- <node name="loop_fusion" pkg="loop_fusion" exec="loop_fusion_node" output="screen"/> -->
    
    <!-- Optional: Global fusion node -->
    <!-- <node name="global_fusion" pkg="global_fusion" exec="global_fusion_node" output="screen"/> -->
    
</launch>
